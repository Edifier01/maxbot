# Домен и HTTPS (Caddy + Let's Encrypt)
DOMAIN=sender.example.com
LETSENCRYPT_EMAIL=admin@example.com

# PostgreSQL
POSTGRES_PASSWORD=change-me-strong

# Серверный режим (SaaS)
JWT_SECRET=change-me-random-64-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token
WEBHOOK_ALLOWED_HOSTS=
# Only these direct peers may supply X-Forwarded-For/forwarded ingress data.
# The default covers the private Docker network used by the Caddy sidecar.
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Host directory containing platform-authorization.json (mounted read-only).
# Missing, expired, or out-of-scope records keep MAX actions unavailable.
MAX_PLATFORM_AUTHORIZATION_DIR=./authorization

# Created outside max_server_data by the restore runbook; never release automatically.
# MAX_RECOVERY_HOLD_FILE=/app/control/recovery-hold.json

TELEGRAM_BOT_TOKEN=
# ID чата/канала для алертов (например -1001234567890)
TELEGRAM_CHAT_ID=

# Приложение (внутри Docker-сети)
MAX_HOST=0.0.0.0
MAX_PORT=8765
# Политика campaign owner фиксирована: один worker на tenant.
WORKER_POOL_SIZE=1
# Операционное время фиксировано в коде как UTC+3; отдельный timezone override не используется.

# Redis / Celery (опционально)
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0
USE_CELERY=0

# Регистрация новых учреждений: 1=открыта, 0=только через ADMIN_EMAIL/PASSWORD
REGISTRATION_OPEN=0

# Auth brute-force protection (login/register)
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SEC=900
