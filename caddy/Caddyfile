# DOMAIN и LETSENCRYPT_EMAIL — environment контейнера caddy (из .env)
# В Caddyfile переменные окружения: {$VAR}, не {env.VAR}

{
	email {$LETSENCRYPT_EMAIL}
}

{$DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
	}
	@public_onboarding path /join /join/* /api/public/onboarding/*
	header @public_onboarding {
		Cache-Control "no-store, private"
		Pragma "no-cache"
		Referrer-Policy "no-referrer"
	}
	reverse_proxy app:8765 {
		transport http {
			versions 1.1
		}
	}
}
