# Домен и HTTPS (Caddy + Let's Encrypt)
DOMAIN=sender.example.com
LETSENCRYPT_EMAIL=admin@example.com

# PostgreSQL
POSTGRES_PASSWORD=change-me-strong

# Серверный режим (SaaS)
JWT_SECRET=change-me-random-64-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Приложение (внутри Docker-сети)
MAX_HOST=0.0.0.0
MAX_PORT=8765
WORKER_POOL_SIZE=4

# Redis / Celery (опционально)
REDIS_URL=redis://redis:6379/0
USE_CELERY=0
